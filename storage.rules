rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — stored as profile_photos/{userId}.jpg
    // Any signed-in user may read (riders and drivers see each other's avatars).
    // A user may only write their own photo; must be an image under 10 MB.
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Everything else is denied by default.
  }
}
