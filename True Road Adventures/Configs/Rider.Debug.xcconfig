// Rider Debug configuration
// xcconfig treats // as a comment, so URLs must be written with _S = / to produce ://
_S = /
API_BASE_URL = https:$(_S)$(_S)api.dev.trueroad.app/rider
PUSH_UPLOAD_URL = https:$(_S)$(_S)api.dev.trueroad.app/push/token
PAYMENT_PUBLIC_KEY = pk_test_rider_xxxxxxxx
FEATURE_FLAGS = DEBUG
USE_MOCK_API = NO
GOOGLE_MAPS_API_KEY = AIzaSyDeGR7x4rEIlORGGHEy9oAqi6kfZNJPzaI
GOOGLE_PLACES_API_KEY = AIzaSyDeGR7x4rEIlORGGHEy9oAqi6kfZNJPzaI
// Server-side key: no platform restrictions, API restriction = Directions API only.
// Create it at https://console.cloud.google.com/apis/credentials
GOOGLE_DIRECTIONS_API_KEY = REPLACE_WITH_SERVER_KEY
CUSTOMER_BUNDLE_ID = com.trueroadadventures.customer.ios
DRIVER_BUNDLE_ID = com.trueroadadventures.driver.ios
